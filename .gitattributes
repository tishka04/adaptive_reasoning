.gitattributes text eol=lf
.gitignore text eol=lf
training/*.jsonl filter=lfs diff=lfs merge=lfs -text
training/**/*.jsonl filter=lfs diff=lfs merge=lfs -text
models/*.joblib filter=lfs diff=lfs merge=lfs -text
models/sage11/*.safetensors filter=lfs diff=lfs merge=lfs -text
models/sage11/*.pt filter=lfs diff=lfs merge=lfs -text

